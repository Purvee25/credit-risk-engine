# Credit Risk Decision Engine — backend configuration.
# Copy to `.env` and set for your environment. Never commit real secrets.

# Signs session tokens. REQUIRED in production — without it a random key is
# generated per process, so every restart signs everyone out.
#   python -c "import secrets; print(secrets.token_hex(32))"
CR_SECRET_KEY=

# Session lifetime in seconds (default 8 hours).
CR_TOKEN_TTL=28800

# Audit trail + user accounts. SQLite by default; point at Postgres in prod,
# e.g. postgresql+psycopg://user:pass@host/credit_risk
CR_DATABASE_URL=sqlite:///data/decisions.db

# CORS allowlist (comma-separated origins). REQUIRED in production.
CR_ALLOWED_ORIGINS=http://localhost:5175,http://localhost:5173

# Optional extra gate on top of session auth: if set, /api/score and
# /api/score-csv also require header `X-API-Key: <value>`.
CR_API_KEY=

# Rate limit (requests per minute per client IP).
CR_RATE_LIMIT_PER_MIN=60

# Upload guardrails.
CR_MAX_UPLOAD_BYTES=2000000
CR_MAX_ROWS=10000

# Logging level (DEBUG, INFO, WARNING, ERROR).
CR_LOG_LEVEL=INFO
